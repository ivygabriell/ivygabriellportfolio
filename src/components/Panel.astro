---
interface Props { id?: string; label?: string; cursorIcon?: string }
const { id, label, cursorIcon } = Astro.props;
---

<section class="Preview" id={id} aria-label={label}>
  <div class="container">
    <div class="main" data-reveal="panel" data-cursor-icon={cursorIcon}>
      <div class="media"><slot /></div>
    </div>
  </div>
</section>

<style>
  .Preview {
    padding-bottom: 12rem;
  }
  .main {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-card);
    background: var(--c-lavender);
  }
  .media {
    position: absolute;
    inset: -10% 0;
  }
  .media :global(img),
  .media :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 767px) {
    .Preview {
      padding-bottom: 8rem;
    }
    .main {
      aspect-ratio: 355 / 400;
    }
  }
</style>
