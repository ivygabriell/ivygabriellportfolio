---
import { copy } from '../lib/copy';
import { site } from '../content/site';
import type { Locale } from '../lib/i18n';
import Divider from './Divider.astro';
import SocialIcon from './SocialIcon.astro';

interface Props { locale: Locale; base?: string }
const { locale, base = '' } = Astro.props;
const t = copy[locale];
const withContact = Astro.slots.has('contact');
const links = [
  { href: `${base}#sobre`, label: t.nav.about },
  { href: `${base}#servicos`, label: t.nav.services },
  { href: `${base}#contato`, label: t.nav.contact },
];
---

<footer class:list={['Footer', '-inverse', { '-with-contact': withContact }]}>
  <div class="container--narrow top">
    <nav class="links" aria-label={t.footer.navLabel}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    {withContact && <div class="contact"><slot name="contact" /></div>}
  </div>
  <div class="container--narrow rule"><Divider /></div>
  <div class="container--narrow bottom">
    <p class="rights">{t.footer.rights}</p>
    <ul class="socials" aria-label={t.footer.socialLabel}>
      {site.socials.map((s) => (
        <li><a class="circle" href={s.url} rel="noopener" aria-label={s.label} data-cursor-icon="arrow-up-right"><SocialIcon id={s.id} /></a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .Footer {
    padding-block: 8rem;
    border-radius: 0;
  }
  .Footer.-with-contact {
    padding-top: 18rem;
  }
  .top {
    display: grid;
    grid-template-columns: 1fr minmax(0, 81rem) 1fr;
    align-items: start;
    gap: 4rem;
  }
  .contact {
    grid-column: 2;
  }
  .links {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    gap: 1.6rem;
    justify-items: start;
    font-size: 2.4rem;
  }
  .rule {
    margin-top: 6rem;
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 8rem;
  }
  .rights {
    font-size: 1.6rem;
    color: var(--c-paper-soft);
  }
  .socials {
    display: flex;
    gap: 1.4rem;
  }
  .circle {
    display: grid;
    place-items: center;
    width: 5.4rem;
    height: 5.4rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    transition: background-color 0.4s;
  }
  .circle:hover {
    background: var(--c-bg);
    color: var(--c-ink);
  }
  @media (max-width: 767px) {
    .Footer {
      padding-block: 6rem;
    }
    .Footer.-with-contact {
      padding-top: 10rem;
    }
    .top {
      grid-template-columns: 1fr;
    }
    .contact {
      grid-column: 1;
      order: -1;
    }
    .links {
      grid-column: 1;
      grid-row: auto;
    }
    .rule {
      margin-top: 4rem;
    }
    .bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 3rem;
      margin-top: 5rem;
    }
  }
</style>
