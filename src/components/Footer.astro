---
import { copy } from '../lib/copy';
import { site } from '../content/site';
import type { Locale } from '../lib/i18n';
import Divider from './Divider.astro';
import SocialIcon from './SocialIcon.astro';

interface Props { locale: Locale; base?: string }
const { locale, base = '' } = Astro.props;
const t = copy[locale];
const withContact = Astro.slots.has('contact');
const links = [
  { href: `${base}#sobre`, label: t.nav.about },
  { href: `${base}#servicos`, label: t.nav.services },
  { href: `${base}#contato`, label: t.nav.contact },
];
---

<footer class:list={['Footer', { '-with-contact': withContact }]}>
  <div class="container--narrow top">
    <nav class="links" aria-label={t.footer.navLabel}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    {withContact && <div class="contact"><slot name="contact" /></div>}
  </div>
  <div class="container--narrow rule"><Divider /></div>
  <div class="container--narrow bottom">
    <p class="rights">{t.footer.rights}</p>
    <ul class="socials" aria-label={t.footer.socialLabel}>
      {site.socials.map((s) => (
        <li><a class="circle" href={s.url} rel="noopener" aria-label={s.label}><SocialIcon id={s.id} /></a></li>
      ))}
    </ul>
  </div>
</footer>

<style>
  /* Cobalto da marca, entrando por cima do azul-noite dos Serviços com os cantos de cima arredondados. */
  .Footer {
    position: relative;
    margin-top: calc(-1 * var(--r-top));
    padding-block: 5rem;
    color: #fff;
    background: var(--c-accent);
    border-radius: var(--r-top) var(--r-top) 0 0;
  }
  .Footer.-with-contact {
    padding-top: 16rem;
  }
  /* Faixa: links à esquerda e o Contato no meio, alinhados pela base (colados na linha divisória). */
  .top {
    display: grid;
    grid-template-columns: 1fr minmax(0, 81rem) 1fr;
    align-items: end;
    gap: 4rem;
  }
  .contact {
    grid-column: 2;
  }
  .links {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    font-size: 2.4rem;
  }
  .rule {
    margin-top: 4rem;
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 5rem;
  }
  .rights {
    font-size: 1.6rem;
    color: rgb(255 255 255 / 0.9);
  }
  .socials {
    display: flex;
    gap: 1.4rem;
  }
  .circle {
    display: grid;
    place-items: center;
    width: 5.4rem;
    height: 5.4rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
    transition: background-color 0.4s;
  }
  @media (pointer: fine) {
    .circle:hover {
      background: var(--c-bg);
      color: var(--c-ink);
    }
  }
  @media (max-width: 767px) {
    .Footer {
      padding-block: 4rem;
    }
    .Footer.-with-contact {
      padding-top: 11rem;
    }
    .top {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .contact {
      grid-column: 1;
      order: -1;
    }
    .links {
      grid-column: 1;
      grid-row: auto;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      font-size: 2rem;
    }
    .links a {
      padding: 1rem 0;
    }
    .rule {
      margin-top: 3rem;
    }
    .bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 2.4rem;
      margin-top: 4rem;
    }
    .rights {
      font-size: 1.4rem;
    }
    .socials {
      align-self: stretch;
      justify-content: space-between;
    }
  }
</style>
