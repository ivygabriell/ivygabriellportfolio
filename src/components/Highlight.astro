---
import { copy } from '../lib/copy';
import { site } from '../content/site';
import { media } from '../content/media';
import type { Locale } from '../lib/i18n';
import Panel from './Panel.astro';
import ShowreelModal from './ShowreelModal.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale].highlight;
const video = site.highlightVideo;
---

<Panel id="destaque" label={t.label} cursorIcon={video ? 'play' : undefined}>
  <picture class="poster">
    <source media="(max-width: 767px)" srcset={media.highlight.mobile.poster} />
    <img src={media.highlight.desktop.poster} width="1280" height="720" alt="" fetchpriority="high" decoding="async" />
  </picture>
  <video
    class="clip"
    data-src-desktop={media.highlight.desktop.video}
    data-src-mobile={media.highlight.mobile.video}
    muted
    loop
    playsinline
    preload="none"
    disablepictureinpicture
    disableRemotePlayback
    aria-hidden="true"
    tabindex="-1"></video>
</Panel>
{video && <ShowreelModal src={video} />}

<style>
  .poster,
  .clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .poster :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* O vídeo entra por cima da capa quando começa a tocar (highlight-video.ts põe .is-playing). */
  .clip {
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }
  .clip:global(.is-playing) {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .clip {
      transition: none;
    }
  }
</style>
