<div class="Divider" aria-hidden="true"></div>

<style>
  /* Sem JavaScript fica uma linha reta; divider.ts troca por uma curva que segue o mouse (.is-live). */
  .Divider {
    position: relative;
    height: 1px;
    color: var(--c-line);
    background: currentColor;
  }
  .Divider:global(.is-live) {
    background: none;
  }
  @media (pointer: fine) {
    .Divider::before {
      content: '';
      position: absolute;
      top: -1rem;
      left: 0;
      right: 0;
      display: block;
      height: 2rem;
    }
  }
  .Divider :global(svg) {
    position: absolute;
    top: -99px;
    left: 0;
    right: 0;
    width: 100%;
    height: 200px;
    pointer-events: none;
    touch-action: none;
  }
  .Divider :global(path) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1px;
  }
  :global(.-inverse) .Divider,
  :global(.Footer) .Divider {
    color: var(--c-line-inverse);
  }
</style>
