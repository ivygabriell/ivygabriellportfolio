---
import { copy } from '../lib/copy';
import type { Locale } from '../lib/i18n';
import { media } from '../content/media';
import Divider from './Divider.astro';

interface Props { locale: Locale }
const t = copy[Astro.props.locale].services;
---

<section class="Work -inverse" id="servicos">
  <div class="container--narrow head">
    <h2 data-reveal="words">{t.title}</h2>
    <div class="rule"><Divider /></div>
  </div>
  <ul class="cards container--narrow">
    {t.items.map((item, i) => (
      <li class="cell">
        <article class="Card" data-reveal="fade-up">
          <div class="Card__media">
            <video
              src={media.services[i].video}
              poster={media.services[i].poster}
              width="1080"
              height="1350"
              muted
              loop
              playsinline
              preload="metadata"
              disablepictureinpicture
              disableRemotePlayback
              aria-hidden="true"
              tabindex="-1"></video>
          </div>
          <h3 class="Card__title">{item.title}</h3>
          <p class="Card__text">{item.text}</p>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  .Work {
    padding-block: 14rem calc(16rem + var(--r-top));
  }
  .head {
    padding-bottom: 10rem;
  }
  .rule {
    margin-top: 5rem;
  }
  h2 {
    font-size: var(--fs-h2);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12rem 10rem;
    align-items: start;
  }
  .cell:nth-child(even) {
    margin-top: 12rem;
  }
  .Card {
    display: block;
  }
  .Card__media {
    overflow: hidden;
    border-radius: var(--r-card);
    aspect-ratio: 4 / 5;
    background: var(--c-accent);
  }
  .Card__media :global(video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .Card__title {
    margin-top: 3rem;
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.05;
  }
  .Card__text {
    max-width: 44rem;
    margin-top: 1.6rem;
    font-size: var(--fs-sub);
    line-height: 1.15;
    color: var(--c-paper-soft);
  }
  @media (max-width: 767px) {
    .Work {
      padding-block: 8rem calc(10rem + var(--r-top));
    }
    .head {
      padding-bottom: 4rem;
    }
    h2 {
      font-size: 4.5rem;
    }
    /* Como no "Selected work" do Cuberto: sem linha entre o título e os cartões. */
    .rule {
      display: none;
    }
    .Card__media {
      aspect-ratio: 365 / 420;
    }
    .cards {
      grid-template-columns: 1fr;
      gap: 6rem;
    }
    .cell:nth-child(even) {
      margin-top: 0;
    }
  }
</style>
