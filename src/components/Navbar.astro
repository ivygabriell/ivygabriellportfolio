---
import { copy } from '../lib/copy';
import { site } from '../content/site';
import { HTML_LANG, homePath, otherLocale, type Locale } from '../lib/i18n';
import Pill from './Pill.astro';

interface Props {
  locale: Locale;
  base?: string;
  switchHref: string;
}
const { locale, base = '', switchHref } = Astro.props;
const t = copy[locale].nav;
const other = otherLocale(locale);
const links = [
  { href: `${base}#sobre`, label: t.about },
  { href: `${base}#servicos`, label: t.services },
];
---

<header class="Navbar">
  <div class="bar">
    <a class="logo" href={homePath(locale)} aria-label={`${site.wordmark} — ${site.name}`}>
      {[...site.wordmark].map((ch) => <span class="logo__ch">{ch}</span>)}
    </a>
    <button class="toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label={t.menu}>
      <span></span><span></span>
    </button>
    <nav id="menu" class="menu" aria-label={site.name}>
      <div class="menu__inner">
        <ul class="navs">
          {links.map((l) => <li><a class="nav" href={l.href}>{l.label}</a></li>)}
        </ul>
        <a
          class="lang action"
          href={switchHref}
          data-lang-switch
          data-base={switchHref}
          hreflang={HTML_LANG[other]}
          aria-label={`${other.toUpperCase()} — ${t.langAria}`}>{other.toUpperCase()}</a
        >
        <Pill class="action" href={`${base}#contato`}>{t.contact}</Pill>
      </div>
    </nav>
  </div>
</header>

<style>
  .Navbar {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 50;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem var(--gutter);
  }
  .logo {
    display: inline-flex;
    font-size: 4rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .logo__ch {
    display: inline-block;
  }
  .menu {
    display: flex;
    align-items: center;
    gap: 3.6rem;
  }
  /* No desktop o invólucro não existe para o layout; no mobile é ele que a gaveta abre. */
  .menu__inner {
    display: contents;
  }
  .navs {
    display: flex;
    gap: 3.6rem;
    font-size: 2rem;
  }
  .nav {
    position: relative;
    padding-block: 0.4rem;
  }
  .nav::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }
  @media (pointer: fine) {
    .nav:hover::after {
      transform: scaleX(1);
    }
  }
  .lang {
    font-size: 2rem;
    font-weight: 500;
  }
  .toggle {
    display: none;
  }

  /* Estado fixo: some ao descer, volta ao subir (classes ligadas por navbar.ts) */
  .Navbar:global(.-fixed) {
    position: fixed;
    transform: translateY(-120%);
    transition: transform 0.6s var(--ease-out);
    background: rgb(247 248 252 / 0.88);
    backdrop-filter: blur(1.2rem);
  }
  .Navbar:global(.-fixed.-visible) {
    transform: none;
  }

  /* Mobile: pílula de vidro fixa (medidas do Cuberto, docs/mobile/AUDITORIA.md). Sempre visível; ao rolar
     encolhe (navbar.ts põe .-fixed) e o menu abre como uma gaveta dentro dela. */
  @media (max-width: 767px) {
    .bar {
      position: fixed;
      top: 1rem;
      left: 1rem;
      right: 1rem;
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-rows: 4.8rem auto;
      align-items: center;
      padding: 0 1.5rem;
      transition:
        left 0.8s var(--ease-out),
        right 0.8s var(--ease-out);
    }
    .bar::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      border: 1px solid var(--c-line);
      border-radius: 2.5rem;
      background: rgb(247 248 252 / 0.7);
      backdrop-filter: blur(8px);
      transition:
        border-radius 0.4s,
        backdrop-filter 0.4s;
    }
    .Navbar:global(.-open) .bar::before {
      border-radius: 1.6rem;
      backdrop-filter: blur(15px);
    }
    .Navbar:global(.-fixed:not(.-open)) .bar {
      left: 6.2rem;
      right: 6.2rem;
    }
    .logo {
      font-size: 2.6rem;
    }
    .toggle {
      position: relative;
      display: grid;
      align-content: center;
      gap: calc(0.6rem - 2px);
      width: 2.6rem;
      height: 2.6rem;
    }
    /* Área de toque maior que o desenho. */
    .toggle::before {
      content: '';
      position: absolute;
      inset: -1rem;
    }
    .toggle span {
      height: 2px;
      background: currentColor;
      transition: transform 0.5s var(--ease-out);
    }
    .Navbar:global(.-open) .toggle span:first-child {
      transform: translateY(0.3rem) rotate(45deg);
    }
    .Navbar:global(.-open) .toggle span:last-child {
      transform: translateY(-0.3rem) rotate(-45deg);
    }
    .menu {
      grid-column: 1 / -1;
      display: grid;
      grid-template-rows: 0fr;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      transition:
        grid-template-rows 0.5s cubic-bezier(0.2, 0, 0, 1),
        opacity 0.4s,
        visibility 0s 0.5s;
    }
    .Navbar:global(.-open) .menu {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }
    /* Sem respiro vertical nem borda aqui: eles impediriam a linha 0fr de fechar a gaveta. O respiro lateral
       (compensado pela margem) evita cortar o contorno de foco dos links. */
    .menu__inner {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 3rem;
      min-height: 0;
      overflow: hidden;
      margin-inline: -0.6rem;
      padding-inline: 0.6rem;
    }
    .navs {
      align-self: stretch;
      flex-direction: column;
      gap: 1.2rem;
      padding-top: 2.4rem;
      border-top: 1px solid var(--c-line);
      font-size: 3.6rem;
      line-height: 1.15;
    }
    .menu__inner > :last-child {
      margin-bottom: 2.4rem;
    }
    /* A barra é fixa por conta própria: o header não desliza nem ganha fundo no estado fixo. */
    .Navbar:global(.-fixed) {
      position: absolute;
      transform: none;
      transition: none;
      background: none;
      backdrop-filter: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar,
    .bar::before,
    .menu,
    .toggle span {
      transition: none;
    }
  }

  /* Sem JavaScript o menu do mobile fica sempre aberto em linha, para continuar navegável */
  :global(html:not(.js)) .toggle {
    display: none;
  }
  @media (max-width: 767px) {
    :global(html:not(.js)) .Navbar {
      position: relative;
    }
    :global(html:not(.js)) .bar {
      position: relative;
      inset: auto;
      margin: 1rem;
      grid-template-rows: 4.8rem auto;
    }
    :global(html:not(.js)) .menu {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
    }
    :global(html:not(.js)) .menu__inner {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 1.6rem 2.4rem;
      padding-block: 1.6rem;
      border-top: 1px solid var(--c-line);
    }
    :global(html:not(.js)) .menu__inner > :last-child {
      margin-bottom: 0;
    }
    :global(html:not(.js)) .navs {
      align-self: auto;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1.6rem 2.4rem;
      padding-top: 0;
      border-top: 0;
      font-size: 2rem;
    }
  }
</style>
